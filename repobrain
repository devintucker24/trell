#!/usr/bin/env python3
"""RepoBrain command entry point.

Issue #11 establishes only the evaluation boundary. The complete technical
dispatcher is added by the later CLI slice.
"""

from __future__ import annotations

import sys
from pathlib import Path

SCRIPTS = (
    Path(__file__).resolve().parent
    / "docs"
    / "wiki"
    / "_system"
    / "scripts"
)
sys.path.insert(0, str(SCRIPTS))


def main() -> int:
    if len(sys.argv) >= 2 and sys.argv[1] == "eval":
        from repobrain_eval import main as eval_main

        return eval_main(sys.argv[2:])
    print("usage: repobrain eval [--config PATH] [--output-dir PATH]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
