// Palimpsest Tour: The Epistemic Memory Language
// Declarative belief revision, authority lattices, temporal shadowing, and TMS.

authority Compliance > Policy > User > Unverified;

scope enterprise.acme {
    // Assert foundational policies with provenance and lifetimes
    assert policy.vacation_days = 20 @ authority(Policy), source("hr_handbook_2026"), ttl(365d);
    assert security.tier = "restricted" @ authority(Compliance), source("soc2_audit");

    // Employee claims conflicting vacation days
    assert policy.vacation_days = 25 @ authority(User), source("slack_chat_942");

    // User updates profile chronologically
    assert user.alice.city = "Lisbon" @ authority(User), source("onboarding_doc"), at("2026-03-01T00:00:00Z");
    assert user.alice.city = "Berlin" @ authority(User), source("relocation_ticket"), at("2026-08-15T00:00:00Z");
}

print "1. Current Residence (shadowing resolved):";
print recall enterprise.acme.user.alice.city;

print "\n2. Time-Travel Recall (March 2026):";
print recall as_of("2026-04-01T00:00:00Z") enterprise.acme.user.alice.city;

print "\n3. Vacation Policy (Policy prevails over User override):";
print recall enterprise.acme.policy.vacation_days;

print "\n4. Epistemic Audit Trail for Alice's City:";
print audit enterprise.acme.user.alice.city;

print "\n5. Retraction & Fallback:";
retract source "relocation_ticket";
print "After retracting relocation ticket, city falls back to:";
print recall enterprise.acme.user.alice.city;
