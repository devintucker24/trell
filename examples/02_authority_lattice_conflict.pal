// Example 2: Authority Lattice and Conflict Reporting
// Demonstrates that low-authority sources cannot override high-authority rules,
// even when more recent, and the conflict is reported explicitly.

authority Compliance > Policy > User > Unverified;

// High-authority handbook policy
assert employee.alice.pto_days = 20 @ authority(Policy), source("hr_handbook_2026"), at("2026-01-01T00:00:00Z");

// User later claims 25 days in Slack
assert employee.alice.pto_days = 25 @ authority(User), source("slack_chat_942"), at("2026-09-02T11:00:00Z");

print "--- Recalled PTO (Policy wins over User) ---";
let pto = recall employee.alice.pto_days;
print pto;
assert_eq pto, 20;

print "--- Defeasance Conflicts ---";
print conflicts;
